{
  "name": "plusapp",
  "author": "Arthur França",
  "version": "1.0.0",
  "description": "+App, the First Nostr App Store",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "// link:nappup": "Register the nappup checkout with the current Node/npm installation and restore the local link.",
    "link:nappup": "(cd ../../nappup && npm link) && npm link nappup --no-save --package-lock=false",
    "start": "NODE_ENV=development node bin/build.js",
    "build": "NODE_ENV=production node bin/build.js",
    "upload": "npm run build && nappup ./dist/nappstore/",
    "serve": "python3 server.py",
    "test": "node --test 'tests/**/*.test.js'",
    "test:only": "node --test --test-only 'tests/**/*.test.js'"
  },
  "imports": {
    "#f": "thenameisf",
    "#f/*": "thenameisf/*",
    "#bin/*": "./bin/*",
    "#lib/*": "./lib/*",
    "#*": [
      "./src/*"
    ],
    "#assets/*": "./src/assets/*",
    "#config/*": "./src/config/*",
    "#helpers/*": "./src/helpers/*",
    "#services/*": "./src/services/*",
    "#hooks/*": "./src/components/hooks/*",
    "#shared/*": "./src/components/shared/*",
    "#views/*": "./src/components/views/*"
  },
  "dependencies": {
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.3.0",
    "libp2r2p": "^0.10.12",
    "nappup": "^2.3.11",
    "nmmr": "^2.0.0",
    "thenameisf": "^1.2.8",
    "url-router": "^13.0.0"
  },
  "devDependencies": {
    "core-js": "^3.46.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "eslint-plugin-html": "^8.1.2",
    "globals": "^15.12.0",
    "jsonc-parser": "^3.3.1",
    "neostandard": "^0.12.1"
  }
}
